PORT=5000
DB_USERNAME=auth_app
DB_PASSWORD=replace-with-a-strong-password
DB_DATABASE=auth_db
DB_HOST=localhost
# Optional PEM CA for a remote PostgreSQL server that requires TLS (literal newlines or \\n).
# Private-network PostgreSQL should leave this unset; certificate checks are never disabled.
# DB_SSL_CA=-----BEGIN CERTIFICATE-----\\n...\\n-----END CERTIFICATE-----
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=604800
